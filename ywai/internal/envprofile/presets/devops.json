{
  "name": "devops",
  "description": "Infra & CI/CD: Azure Pipelines, Helm/AKS, Docker and Azure DevOps work items. DevOps agent by default; destructive cluster and cloud commands are blocked.",
  "groups": ["core", "experiment"],
  "skills": ["devops", "docker", "ado", "diks", "git-commit", "diagnosing-bugs", "bulk-read"],
  "mcp": ["grafana", "microsoft-learn", "graft"],
  "default_agent": "devops",
  "default_model": "opencode-admin/glm-5.3-flash",
  "deny_bash": ["kubectl delete*", "helm uninstall*", "helm update*", "helm install*", "terraform destroy*", "terraform apply*", "az group delete*", "git push --force*"],
  "cli_theme": "vercel",
  "copy_global_providers": true
}
